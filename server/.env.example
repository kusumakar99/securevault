# Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# JWT Secret (generate a strong random string)
JWT_SECRET=change-this-to-a-very-long-random-string

# Dead Man's Switch Settings
DMS_CHECK_INTERVAL_HOURS=24
DMS_INITIAL_WAIT_DAYS=7
DMS_GRACE_PERIOD_DAYS=14
DMS_TOTAL_WAIT_DAYS=21

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=SecureVault <your-email@gmail.com>

# Google Gemini API Key (for document auto-extraction)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# App URL (for email links)
APP_URL=http://localhost:5173
